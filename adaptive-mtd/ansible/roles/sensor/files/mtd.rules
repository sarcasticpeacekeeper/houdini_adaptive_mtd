# Adaptive MTD Lab — Suricata custom rules
# SIDs in the 9000000 range (local) to avoid collisions with ET/Open.
# See docs/MITRE_MAPPING.md for the full severity -> threat_level bump mapping.

# T1046 — Network Service Scanning (nmap -sS)
# Triggers when a single source sends >=30 SYN packets in 10 seconds.
alert tcp $HOME_NET any -> $HOME_NET any (msg:"MTD-LAB T1046 port scan detected (nmap)"; flags:S,12; ttl:40-60; detection_filter:track by_src, count 30, seconds 10; sid:9000001; rev:1; classtype:attempted-recon; priority:2;)

# T1110 — Brute Force (SSH)
# Triggers when a single source sends >=20 SSH SYN in 30 seconds.
alert tcp $HOME_NET any -> $HOME_NET 22 (msg:"MTD-LAB T1110 SSH brute force"; flags:S; detection_filter:track by_src, count 20, seconds 30; sid:9000002; rev:2; classtype:attempted-admin; priority:1;)

# T1190 — Exploit Public-Facing Application (sqlmap user-agent)
alert http $HOME_NET any -> $HOME_NET any (msg:"MTD-LAB T1190 sqlmap user-agent detected"; flow:to_server; content:"sqlmap"; http_user_agent; nocase; sid:9000003; rev:2; classtype:web-application-attack; priority:1;)

# T1190 — SQLi probe pattern in URI
alert http $HOME_NET any -> $HOME_NET any (msg:"MTD-LAB T1190 SQLi probe pattern"; flow:to_server; content:"/"; http_uri; pcre:"/(\bunion\b|\bselect\b|\bor\b).*(--|#|')/Ui"; sid:9000004; rev:2; classtype:web-application-attack; priority:1;)

# T1592 — Gather Victim Host Info (nmap -sV)
alert tcp $HOME_NET any -> $HOME_NET any (msg:"MTD-LAB T1592 service version probe (nmap -sV)"; flags:S,12; ttl:40-60; dsize:0; detection_filter:track by_src, count 10, seconds 5; sid:9000005; rev:1; classtype:attempted-recon; priority:2;)
